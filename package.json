{
  "name": "pear-mobile",
  "version": "0.1.1-rc",
  "description": "Embeddable Pear runtime for mobile applications",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "lib/pear.bundle.js"
  ],
  "scripts": {
    "build": "npx bare-pack --host ios --host android --linked --out ./lib/pear.bundle.js ./lib/pear.js",
    "format": "prettier . --write",
    "test": "prettier . --check && lunte && brittle-bare test/index.js",
    "lint": "lunte"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/pear-mobile.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-mobile/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-mobile",
  "devDependencies": {
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "bare-pack": "^2.0.0"
  },
  "dependencies": {
    "b4a": "^1.7.4",
    "bare-rpc": "^1.1.0",
    "react-native-fs": "^2.20.0",
    "hyperdrive": "^13.2.1",
    "hyperswarm": "^4.16.0",
    "localdrive": "^2.2.0",
    "pear-link": "^4.2.1",
    "bare-path": "^3.0.0",
    "corestore": "^7.8.0",
    "hypercore-id-encoding": "^1.3.0",
    "ready-resource": "^1.2.0"
  },
  "peerDependencies": {
    "react-native-bare-kit": "*",
    "@react-native-async-storage/async-storage": "*",
    "react-native": "*"
  }
}
