{
  "name": "pear-mobile",
  "version": "4.2.2",
  "description": "Embeddable Pear runtime for mobile applications",
  "main": "bare.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "react-native": "./react-native.js",
      "types": "./react-native.d.ts",
      "default": "./bare.js"
    }
  },
  "files": [
    "package.json",
    "bare.js",
    "react-native.js",
    "react-native.d.ts"
  ],
  "scripts": {
    "format": "prettier . --write",
    "test": "prettier . --check && lunte && brittle-bare test/index.js",
    "lint": "lunte"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/pear-mobile.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-mobile/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-mobile",
  "devDependencies": {
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "dependencies": {
    "bare-fs": "^4.5.5",
    "bare-path": "^3.0.0",
    "bare-semver": "^1.1.0",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.1",
    "hyperswarm": "^4.17.0",
    "pear-runtime-updater": "github:holepunchto/pear-runtime-updater#add-skip-opt",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  }
}
