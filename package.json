{
  "name": "pear-mobile",
  "version": "3.0.0",
  "description": "Embeddable Pear runtime for mobile applications",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "package.json",
    "index.js",
    "index.d.ts",
    "index.rn.js"
  ],
  "scripts": {
    "format": "prettier . --write",
    "test": "prettier . --check && lunte && brittle-bare test/index.js",
    "lint": "lunte"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/pear-mobile.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-mobile/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-mobile",
  "devDependencies": {
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "dependencies": {
    "bare-fs": "^4.5.5",
    "bare-path": "^3.0.0",
    "bare-storage": "^1.0.1",
    "pear-runtime-updater": "^1.0.0",
    "ready-resource": "^1.2.0"
  }
}
